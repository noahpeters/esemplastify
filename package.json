{
  "name": "esemplastify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "probe:sources": "tsx scripts/probe-sources.ts",
    "deploy": "wrangler deploy",
    "smoke:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261023.2-beta",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  }
}
